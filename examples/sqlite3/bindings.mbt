/// Whether this handle is C's NULL.
pub fn Sqlite3BackupPtr::is_null(self : Sqlite3BackupPtr) -> Bool {
  sqlite3backupptr_is_null(self) != 0
}

/// C's NULL, spelled as this handle's type.
pub fn Sqlite3BackupPtr::null() -> Sqlite3BackupPtr {
  sqlite3backupptr_null()
}

/// An empty slot for a C out-parameter, i.e. a `T **`.
///
/// Pass it where the header asks for `T **`, then read the result back
/// with `read_slot`. The slot is rooted in MoonBit for the whole call, so
/// nothing C writes through it can be collected.
pub fn Sqlite3BackupPtr::slot() -> Bytes {
  sqlite3backupptr_make_slot()
}

/// The handle C wrote into a slot from `slot`.
#borrow(slot)
extern "C" fn sqlite3backupptr_read_slot(slot : Bytes) -> Sqlite3BackupPtr = "moonbind_read_slot"

/// Read back the pointer C stored in `slot`.
pub fn Sqlite3BackupPtr::read_slot(slot : Bytes) -> Sqlite3BackupPtr {
  sqlite3backupptr_read_slot(slot)
}

extern "C" fn sqlite3backupptr_make_slot() -> Bytes = "moonbind_make_slot"

