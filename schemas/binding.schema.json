{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoonBind binding configuration schema 1",
  "type": "object",
  "required": [
    "header"
  ],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "string",
      "minLength": 1
    },
    "out": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "fail_on": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "c_namespace": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "include_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_functions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "copy_strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rename_functions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "status_codes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_params": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "null_params": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "callbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "buffers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_buffers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "managed_outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "strict": {
      "type": "boolean"
    },
    "bridge": {
      "type": "boolean"
    },
    "trace_calls": {
      "type": "boolean"
    }
  },
  "description": "Structural editor validation only. MoonBind additionally checks target values, contract semantics and declaration compatibility. Versionless 0.x configurations retain schema-1 semantics."
}
