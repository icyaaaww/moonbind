//! The files around the generated source.
//!
//! A binding package is not one file. It needs a manifest so MoonBit knows
//! what it is, and — because C hands back strings MoonBit cannot own — a small
//! C helper and its MoonBit wrapper. Writing those by hand at every call site
//! is exactly the work a generator exists to remove, so it writes them.

///|
/// | The manifest for a generated package. The stub is compiled into every
/// | binary that links the bindings, which is what makes `copy_cstr` work.
///
/// `supported-targets` is not optional. Every declaration the generator emits
/// is `extern "C"`, and the wasm-gc backend rejects those outright (error
/// 4156), so a manifest without the restriction turns `moon check` — which
/// defaults to wasm — into eighteen errors about a package the tool just
/// wrote. The spelling has to be the option form: `supported_targets` at the
/// top level is rejected with error 4192 by the same compiler that prints the
/// deprecation warning.
pub fn package_manifest() -> String {
  "options(\n  \"native-stub\": [ \"stub.c\" ],\n  \"supported-targets\": [ \"native\" ],\n)\n"
}

///|
/// | The C half of the helpers: copy a NUL-terminated C string into a fresh
/// | MoonBit `Bytes`, and answer the two questions a handle needs.
///
/// The handle helpers are declared in MoonBit once per handle type, all
/// pointing at these two symbols. C is the same for every pointer type, so
/// only C has to be written once.
pub fn stub_source() -> String {
  let lines = [
    "// Generated by moonbind. Do not edit.", "//", "// A `char *` that a C function returns is memory MoonBit does not own.",
    "// There is no safe way to hand it to MoonBit directly, so it is copied", "// once, here, into a fresh buffer.",
    "#include <stdint.h>", "#include <string.h>", "#include <moonbit.h>", "", "moonbit_bytes_t moonbind_copy_cstr(const char *s) {",
    "  if (s == NULL) {", "    return moonbit_make_bytes_raw(0);", "  }", "  int32_t n = (int32_t)strlen(s);",
    "  moonbit_bytes_t out = moonbit_make_bytes_raw(n);", "  memcpy(out, s, (size_t)n);",
    "  return out;", "}", "", "// A handle is a bare pointer, so NULL is a value it can hold. These exist",
    "// because a MoonBit `None` does not cross the boundary as NULL: it is a", "// box, and its address is what C would see.",
    "void *moonbind_null(void) {", "  return NULL;", "}", "", "int moonbind_is_null(void *p) {",
    "  return p == NULL;", "}", "", "// An out-parameter (`T **`) is a `Bytes` of pointer size. MoonBit owns it,",
    "// so the collector follows it, and C writes the pointer straight into it.",
    "moonbit_bytes_t moonbind_make_slot(void) {", "  moonbit_bytes_t slot = moonbit_make_bytes_raw(sizeof(void *));",
    "  memset(slot, 0, sizeof(void *));", "  return slot;", "}", "", "void *moonbind_read_slot(moonbit_bytes_t slot) {",
    "  void *p;", "  memcpy(&p, slot, sizeof p);", "  return p;", "}",
  ]
  join_lines(lines)
}

///|
/// | The MoonBit half: one function, so a caller never names the C symbol.
pub fn strings_source() -> String {
  let lines = [
    "// Generated by moonbind. Do not edit.", "", "/// Copy a string that C owns into a `Bytes` that MoonBit owns.",
    "///", "/// Every `char *` a binding returns is a bare handle for this reason: the",
    "/// pointer is only valid until the next call into the same library, and", "/// nothing tells MoonBit when that is. Copying at the point of return,",
    "/// while the pointer is still good, is the only safe moment.", "#borrow(s)",
    "extern \"C\" fn moonbind_copy_cstr(s : VoidPtr) -> Bytes = \"moonbind_copy_cstr\"",
    "", "/// Copy a string returned by C. An empty result means C returned NULL.",
    "pub fn copy_cstr(s : VoidPtr) -> Bytes {", "  moonbind_copy_cstr(s)", "}",
  ]
  join_lines(lines)
}

///|
fn join_lines(lines : Array[String]) -> String {
  let buf = StringBuilder()
  for i, l in lines {
    if i > 0 {
      buf.write_char('\n')
    }
    buf.write_string(l)
  }
  buf.to_string()
}
